---

<div class="global-matrix-container">
  <canvas id="global-matrix-canvas"></canvas>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('global-matrix-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    
    let width = window.innerWidth;
    let height = window.innerHeight;
    
    // Set canvas dimensions
    const setCanvasDimensions = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    };
    
    setCanvasDimensions();
    window.addEventListener('resize', setCanvasDimensions);
    
    // Line properties
    const lines = [];
    const maxLines = 150;
    const connectionDistance = 120;
    const lineColors = [
      'rgba(88, 166, 255, 0.4)',  // Main accent color
      'rgba(88, 166, 255, 0.3)',
      'rgba(88, 166, 255, 0.2)',
      'rgba(240, 246, 252, 0.3)', // White text color
      'rgba(139, 148, 158, 0.4)', // Secondary text color
      'rgba(48, 54, 61, 0.6)',    // Border color
    ];
    
    // Node class for connection points
    class Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      color: string;
      connections: Node[];
      
      constructor() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.5;
        this.vy = (Math.random() - 0.5) * 0.5;
        this.radius = Math.random() * 2 + 1;
        this.color = lineColors[Math.floor(Math.random() * lineColors.length)];
        this.connections = [];
      }
      
      update() {
        this.x += this.vx;
        this.y += this.vy;
        
        // Bounce off edges
        if (this.x < 0 || this.x > width) this.vx *= -1;
        if (this.y < 0 || this.y > height) this.vy *= -1;
        
        // Keep within bounds
        this.x = Math.max(0, Math.min(width, this.x));
        this.y = Math.max(0, Math.min(height, this.y));
      }
      
      draw(ctx: CanvasRenderingContext2D) {
        // Draw node
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fillStyle = this.color;
        ctx.fill();
      }
    }
    
    // Line class for dynamic lines
    class DynamicLine {
      x1: number;
      y1: number;
      x2: number;
      y2: number;
      targetX2: number;
      targetY2: number;
      color: string;
      speed: number;
      thickness: number;
      maxLength: number;
      growing: boolean;
      life: number;
      maxLife: number;
      
      constructor() {
        this.reset();
      }
      
      reset() {
        this.x1 = Math.random() * width;
        this.y1 = Math.random() * height;
        this.x2 = this.x1;
        this.y2 = this.y1;
        
        // Random target direction
        const angle = Math.random() * Math.PI * 2;
        this.maxLength = Math.random() * 200 + 50;
        this.targetX2 = this.x1 + Math.cos(angle) * this.maxLength;
        this.targetY2 = this.y1 + Math.sin(angle) * this.maxLength;
        
        this.speed = Math.random() * 2 + 0.5;
        this.color = lineColors[Math.floor(Math.random() * lineColors.length)];
        this.thickness = Math.random() * 1.5 + 0.5;
        this.growing = true;
        this.life = 0;
        this.maxLife = Math.random() * 300 + 200;
      }
      
      update() {
        this.life++;
        
        if (this.growing) {
          // Grow towards target
          const dx = this.targetX2 - this.x2;
          const dy = this.targetY2 - this.y2;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance > this.speed) {
            this.x2 += (dx / distance) * this.speed;
            this.y2 += (dy / distance) * this.speed;
          } else {
            this.growing = false;
          }
        }
        
        // Reset if life exceeded or out of bounds
        if (this.life > this.maxLife || 
            this.x2 < -50 || this.x2 > width + 50 || 
            this.y2 < -50 || this.y2 > height + 50) {
          this.reset();
        }
      }
      
      draw(ctx: CanvasRenderingContext2D) {
        const alpha = Math.max(0, 1 - (this.life / this.maxLife));
        const currentColor = this.color.replace(/[\d\.]+\)$/g, `${alpha * 0.4})`);
        
        ctx.beginPath();
        ctx.moveTo(this.x1, this.y1);
        ctx.lineTo(this.x2, this.y2);
        ctx.strokeStyle = currentColor;
        ctx.lineWidth = this.thickness;
        ctx.stroke();
      }
    }
    
    // Initialize nodes and lines
    const nodes = [];
    for (let i = 0; i < 50; i++) {
      nodes.push(new Node());
    }
    
    for (let i = 0; i < maxLines; i++) {
      lines.push(new DynamicLine());
    }
    
    // Draw connections between nearby nodes
    function drawConnections() {
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          
          if (distance < connectionDistance) {
            const alpha = 1 - (distance / connectionDistance);
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.strokeStyle = `rgba(88, 166, 255, ${alpha * 0.2})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
    }
    
    // Animation loop
    function animate() {
      // Clear canvas with very subtle trail effect
      ctx.fillStyle = 'rgba(13, 17, 23, 0.05)';
      ctx.fillRect(0, 0, width, height);
      
      // Update and draw nodes
      nodes.forEach(node => {
        node.update();
        node.draw(ctx);
      });
      
      // Draw connections between nodes
      drawConnections();
      
      // Update and draw dynamic lines
      lines.forEach(line => {
        line.update();
        line.draw(ctx);
      });
      
      requestAnimationFrame(animate);
    }
    
    animate();
  });
</script>

<style>
  .global-matrix-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  
  canvas {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }
</style>
