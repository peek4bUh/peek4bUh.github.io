<div class="grid-container">
  <canvas id="grid-canvas"></canvas>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('grid-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    
    let width = 0;
    let height = 0;
    
    // Set canvas dimensions
    const setCanvasDimensions = () => {
      const container = document.querySelector('.grid-container');
      if (container) {
        width = container.clientWidth;
        height = container.clientHeight;
        canvas.width = width;
        canvas.height = height;
      }
    };
    
    setCanvasDimensions();
    window.addEventListener('resize', setCanvasDimensions);
    
    // Grid properties
    const gridSize = 30;
    const nodeRadius = 1;
    const lineOpacity = 0.15;
    const activeNodes = [];
    const maxActiveNodes = 5;
    
    // Create grid points
    const gridPoints = [];
    
    function createGrid() {
      gridPoints.length = 0;
      
      for (let x = 0; x <= width; x += gridSize) {
        for (let y = 0; y <= height; y += gridSize) {
          gridPoints.push({ x, y });
        }
      }
    }
    
    createGrid();
    window.addEventListener('resize', createGrid);
    
    // Active node class
    class ActiveNode {
      x: number;
      y: number;
      targetX: number;
      targetY: number;
      speed: number;
      connections: number;
      color: string;
      
      constructor() {
        this.reset();
      }
      
      reset() {
        // Start at a random grid point
        const startPoint = gridPoints[Math.floor(Math.random() * gridPoints.length)];
        this.x = startPoint.x;
        this.y = startPoint.y;
        
        // Target another random grid point
        const targetPoint = gridPoints[Math.floor(Math.random() * gridPoints.length)];
        this.targetX = targetPoint.x;
        this.targetY = targetPoint.y;
        
        // Random speed
        this.speed = Math.random() * 1 + 0.5;
        
        // Number of connections to make
        this.connections = Math.floor(Math.random() * 3) + 2;
        
        // Color
        this.color = 'rgba(88, 166, 255, 0.8)';
      }
      
      update() {
        // Move towards target
        const dx = this.targetX - this.x;
        const dy = this.targetY - this.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        
        if (distance < this.speed) {
          // Reached target, find a new one
          const targetPoint = gridPoints[Math.floor(Math.random() * gridPoints.length)];
          this.targetX = targetPoint.x;
          this.targetY = targetPoint.y;
        } else {
          // Move towards target
          this.x += (dx / distance) * this.speed;
          this.y += (dy / distance) * this.speed;
        }
      }
      
      draw(ctx: CanvasRenderingContext2D) {
        // Draw node
        ctx.beginPath();
        ctx.arc(this.x, this.y, nodeRadius * 2, 0, Math.PI * 2);
        ctx.fillStyle = this.color;
        ctx.fill();
        
        // Draw connections to nearest grid points
        const nearestPoints = findNearestPoints(this.x, this.y, this.connections);
        
        nearestPoints.forEach(point => {
          ctx.beginPath();
          ctx.moveTo(this.x, this.y);
          ctx.lineTo(point.x, point.y);
          ctx.strokeStyle = this.color;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        });
      }
    }
    
    // Find nearest grid points
    function findNearestPoints(x, y, count) {
      return gridPoints
        .map(point => {
          const dx = point.x - x;
          const dy = point.y - y;
          return {
            x: point.x,
            y: point.y,
            distance: Math.sqrt(dx * dx + dy * dy)
          };
        })
        .sort((a, b) => a.distance - b.distance)
        .slice(0, count);
    }
    
    // Initialize active nodes
    for (let i = 0; i < maxActiveNodes; i++) {
      activeNodes.push(new ActiveNode());
    }
    
    // Draw grid
    function drawGrid() {
      ctx.clearRect(0, 0, width, height);
      
      // Draw grid lines
      ctx.strokeStyle = `rgba(48, 54, 61, ${lineOpacity})`;
      ctx.lineWidth = 0.5;
      
      // Vertical lines
      for (let x = 0; x <= width; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      
      // Horizontal lines
      for (let y = 0; y <= height; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }
      
      // Draw grid points
      gridPoints.forEach(point => {
        ctx.beginPath();
        ctx.arc(point.x, point.y, nodeRadius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(139, 148, 158, ${lineOpacity})`;
        ctx.fill();
      });
      
      // Update and draw active nodes
      activeNodes.forEach(node => {
        node.update();
        node.draw(ctx);
      });
      
      requestAnimationFrame(drawGrid);
    }
    
    drawGrid();
  });
</script>

<style>
  .grid-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }
  
  canvas {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }
</style>
