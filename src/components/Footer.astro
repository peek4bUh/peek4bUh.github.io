---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-content">
      <div class="footer-logo">
        <a href="/">Portfolio</a>
      </div>
      <p class="copyright">© {currentYear} John Doe. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 0;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-logo a {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .footer-logo a:hover {
    text-decoration: none;
  }

  .copyright {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
