---
import ArrowLink from "./icons/ArrowLink.astro";

import Tag from "./Tag.astro";

interface Props {
  title: string;
  companyName: string;
  workplace: string;
  date: string;
  description: string;
  link?: string;
  tags: Array<{
    name: string;
    class: string;
  }>;
}

const { title, companyName, workplace, date, description, link, tags } =
  Astro.props;
---

<li class="mb-10 ms-4">
  <div
    class="absolute w-3 h-3 rounded-full mt-2 -start-1.5 border border-(--border-focus) bg-(--border-normal)"
  >
  </div>
  <h3 class="mb-1 text-lg font-semibold text-(--text-normal)">
    <a href={link} target="_blank" rel="noreferrer">
      {title}<ArrowLink class="inline ml-1" /></a
    >
  </h3>
  <h4 class="mb-2 text-sm font-semibold text-(--text-normal)">
    {companyName} · {workplace}
  </h4>
  <time
    class="block mb-2 text-xs font-semibold leading-none text-(--text-normal)"
  >
    {date}
  </time>
  <p class="mb-4 text-(--text-muted) max-w-xl">
    {description}
  </p>
  <ul class="flex flex-wrap gap-2.5 mb-2">
    {tags.map((tag) => <Tag name={tag} />)}
  </ul>
</li>
