---
import ArrowLink from "./icons/ArrowLink.astro";

import Tag from "./Tag.astro";

interface Props {
  title: string;
  companyName: string;
  workplace: string;
  date: string;
  description: string;
  link?: string;
  tags: Array<{
    name: string;
    class: string;
  }>;
}

const { title, companyName, workplace, date, description, link, tags } =
  Astro.props;
---

<div
  class="absolute w-3 h-3 rounded-full mt-2 -start-1.5 border border-gray-900 bg-gray-700"
>
</div>
<h3 class="mb-1 text-lg font-semibold text-(--color-text)">
  <a href={link} target="_blank" rel="noreferrer">
    {title}<ArrowLink class="inline ml-1" /></a
  >
</h3>
<h4 class="mb-2 text-sm font-normal text-gray-200">
  {companyName} · {workplace}
</h4>
<time class="block mb-2 text-xs font-normal leading-none text-gray-200">
  {date}
</time>
<p class="mb-4 text-gray-500">
  {description}
</p>
<ul class="flex flex-wrap gap-2.5 mb-2">
  {tags.map((tag) => <Tag name={tag} />)}
</ul>
