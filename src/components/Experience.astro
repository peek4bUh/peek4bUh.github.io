    title: "Junior Full Stack Developer",
    companyName: "Getronics",
    link: "https://www.getronics.com/",
    workplace: "Remote",
    date: "Oct 2023 – Present",
    description:
      "Internal Iberdrola project focused on modernizing and maintaining a web application used to manage electricity and gas operations across multiple countries including Spain, Portugal, France, Mexico, and the UK.",
    tags: ["Java", "TortoiseSVN", "PL/SQL", "JSF", "JSP", "Spring Boot"],
  },
  {
    title: "Backend Developer",
    companyName: "Getronics (Internship)",
    link: "https://www.getronics.com/",
    workplace: "Hybrid",
    date: "Mar 2023 – Jun 2023",
    description: "Creation of tests for APIs used at INDITEX.",
    tags: ["Java", "Git", "Spring Boot", "GitHub", "Hexagonal Architecture"],
  },
  {
    title: "QA Tester",
    companyName: "Accenture España (Internship)",
    link: "https://www.accenture.com/es-es",
    workplace: "Hybrid",
    date: "Mar 2022 – Jun 2022",
    description:
      "Testing an application similar to Kahoot! on Android and iOS.",
    tags: ["Kotlin", "Xcode", "Android Studio", "Jira", "Scrum"],
  },
  {
    title: "System Administrator",
    companyName: "Oesia (Internship)",
    link: "https://grupooesia.com/",
    workplace: "On-site",
    date: "Oct 2023 – Present",
    description:
