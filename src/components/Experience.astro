  },
];
---

<div class="w-full max-w-lg sm:max-w-2xl xl:max-w-4xl 2xl:max-w-6xl">
  <TitleSection>Work Experience</TitleSection>
  <p class="mb-12 text-(--text-muted) xl:text-xl">
    Companies I have worked for, along with my roles and responsibilities.
  </p>
  <ol class="relative border-s border-(--border-normal)">
    {jobs.map((experience) => <ExperienceItem {...experience} />)}
  </ol>
</div>
