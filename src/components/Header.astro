---
import Logo from "../components/Logo.astro";
import Hamburger from "../components/Hamburger.astro";
import HamburgerMenu from "../components/HamburgerMenu.astro";
---

<header
  id="header"
  class="fixed top-0 flex w-full h-[100px] px-8 bg-(--color-bg) transition-all duration-300 ease-in-out transform z-50"
>
  <nav class="w-full flex justify-between items-center">
    <div class="flex items-center">
      <Logo />
      <div class="hidden lg:flex space-x-4 ml-4 text-xl">
        <a class="text-gray-400" href="https://www.notes.aandradeb.com/"
          >Notes</a
        >
        <a class="text-gray-400" href="https://www.notes.aandradeb.com/blog"
          >Blog</a
        >
      </div>
    </div>
    <div class="hidden lg:flex space-x-4 text-xl">
      <a class="text-gray-400" href="/#about">About</a>
      <a class="text-gray-400" href="/#experience">Experience</a>
      <a class="text-gray-400" href="/#projects">Projects</a>
      <a class="text-gray-400" href="/#contact">Contact</a>
    </div>
    <Hamburger />
  </nav>
  <HamburgerMenu />
</header>
<script src="../scripts/hamburger.js"></script>
<script src="../scripts/header.js"></script>
