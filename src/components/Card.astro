---
import CodeIcon from "./icons/Code.astro";
import ArrowExternalLinkIcon from "./icons/ArrowExternalLink.astro";

import Tag from "./Tag.astro";
import LinkButton from "./LinkButton.astro";
import Ribbon from "./Ribbon.astro";

interface Props {
  title: string;
  description: string;
  img: string;
  source: string;
  live: string;
  tags: string;
  titleRibbon?: string;
}

const { title, description, img, source, live, tags, titleRibbon } =
  Astro.props;
---

<article
  class="bg-(--color-card) rounded-md border border-solid border-(--color-border) flex flex-col h-full relative"
>
  <div>
    {titleRibbon && <Ribbon title={titleRibbon} />}
    <img
      alt="Recién llegado vs 5 años en Nueva Zelanda"
      class="h-50 rounded-t-md"
      loading="lazy"
      src={img}
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl mb-4">{title}</h3>
    <p class="text-(--color-text-secondary) text-sm mb-[1.5rem] grow">
      {description}
    </p>
    <ul class="flex flex-wrap gap-[0.5rem] mb-[1.5rem]">
      {tags.map((tag) => <Tag name={tag} />)}
    </ul>
    <footer class="flex justify-start gap-x-4">
      {
        source && (
          <LinkButton href={source}>
            <CodeIcon />
          </LinkButton>
        )
      }
      {
        live && (
          <LinkButton href={live}>
            <ArrowExternalLinkIcon />
          </LinkButton>
        )
      }
    </footer>
  </div>
</article>
