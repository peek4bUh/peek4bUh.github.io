---
const projects = [
  {
    title: 'My Fitness Journey',
    description:
      'Document your fitness journey, visualize progress, and achieve your goals without any cost or limitations. ',
    tags: ['Flask', 'Sqlite3', 'Tailwind CSS'],
    link: '#',
  },
  {
    title: 'View My Country',
    description:
      'A simple project to display a bunch of countries with its information.',
    tags: ['React'],
    link: '#',
  },
  {
    title: 'Pyfik',
    description: 'A simple and basic monitoring tool made in Tkinter.',
    tags: ['Java'],
    link: '#',
  },
  {
    title: 'Password Generator',
    description: ' A simple and basic monitoring tool made in Tkinter.',
    tags: ['Python', 'Tkinter'],
    link: '#',
  },
];
---

<section id='projects' class='section'>
  <div class='container'>
    <h2 class='section-title'>Projects</h2>
    <p class='section-subtitle'>Some of my recent work</p>

    <div class='projects-grid'>
      {
        projects.map((project) => (
          <div class='card project-card'>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class='tags'>
              {project.tags.map((tag) => (
                <span class='tag'>{tag}</span>
              ))}
            </div>
            <a href={project.link} class='project-link'>
              View Project
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .project-card p {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tag {
    background-color: var(--color-hover);
    color: var(--color-text-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .project-link {
    align-self: flex-start;
    position: relative;
    font-weight: 500;
    padding-right: 1.25rem;
  }

  .project-link::after {
    content: '→';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    transition: transform 0.2s ease;
  }

  .project-link:hover::after {
    transform: translate(4px, -50%);
  }
</style>
