---
import CodeIcon from './icons/Code.astro';
import ArrowExternalLink from './icons/ArrowExternalLink.astro';

const projects = [
  {
    title: 'My Fitness Journey',
    description:
      'Document your fitness journey, visualize progress, and achieve your goals without any cost or limitations. ',
    tags: ['Flask', 'Sqlite3', 'Tailwind CSS'],
    source: 'https://github.com/peek4bUh/my-fitness-journey',
    live: '#',
  },
  {
    title: 'View My Country',
    description:
      'A simple project to display a bunch of countries with its information.',
    tags: ['React'],
    source: 'https://github.com/peek4bUh/view-my-country',
    live: '#',
  },
  {
    title: 'Pyfik',
    description: 'A simple and basic monitoring tool made in Tkinter.',
    tags: ['Java'],
    source: 'https://github.com/peek4bUh/pyfik',
    live: '#',
  },
  {
    title: 'Password Generator',
    description: ' A simple and basic monitoring tool made in Tkinter.',
    tags: ['Python', 'Tkinter'],
    source: 'https://github.com/peek4bUh/password-generator',
    live: '#',
  },
];
---

<section id='projects' class='section'>
  <div class='container'>
    <h2 class='text-4xl mb-8'>Projects</h2>
    <p class='text-lg mb-8'>Some of my recent work</p>

    <div
      class='grid gap-[2rem] grid-cols-[repeat(auto-fill, minmax(300px, 1fr))]'
    >
      {
        projects.map((project) => (
          <div class='card flex flex-col h-full'>
            <h3 class='text-2xl mb-[1rem]'>{project.title}</h3>
            <p class='text-(--color-text-secondary) mb-[1.5rem] grow'>
              {project.description}
            </p>
            <div class='flex flex-wrap gap-[0.5rem] mb-[1.5rem]'>
              {project.tags.map((tag) => (
                <span class='bg-(--color-hover) text-(--color-text-secondary) py-1 px-2 rounded-sm text-sm'>
                  {tag}
                </span>
              ))}
            </div>
            <div class='flex'>
              <a
                class='mr-3'
                href={project.source}
                target='_blank'
                aria-label='GitHub'
                title='GitHub'
              >
                <CodeIcon />
              </a>
              <a
                href={project.live}
                target='_blank'
                aria-label='Live Demo'
                title='Live Demo'
              >
                <ArrowExternalLink />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
