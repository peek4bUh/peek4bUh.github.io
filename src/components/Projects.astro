---
import TitleSection from "./TitleSection.astro";
import Card from "./Card.astro";

const PROJECTS = [
  {
    title: "My Fitness Journey",
    description:
      "Document your fitness journey, visualize progress, and achieve your goals without any cost or limitations. ",
    tags: ["Flask", "SQLite", "Tailwind CSS"],
    img: "/projects/my-fitness-journey.webp",
    source: "https://github.com/peek4bUh/my-fitness-journey",
    titleRibbon: "In Progress",
  },
  {
    title: "View My Country",
    description:
      "A simple project to display a bunch of countries with its information.",
    tags: ["React"],
    img: "/projects/view-my-country.webp",
    source: "https://github.com/peek4bUh/view-my-country",
  },
  {
    title: "Pyfik",
    description: "A simple and basic monitoring tool made in Tkinter.",
    tags: ["Python", "Tkinter"],
    img: "/projects/pyfik.webp",
    source: "https://github.com/peek4bUh/pyfik",
  },
];
---

<div class="max-w-lg sm:max-w-2xl xl:max-w-4xl 2xl:max-w-6xl">
  <TitleSection>Projects</TitleSection>
  <p class="mb-8 text-gray-400 xl:text-xl">Some of my recent work</p>

  <div class="grid gap-8 grid-cols-1 sm:grid-cols-2 xl:grid-cols-3">
    {
      PROJECTS.map((project) => (
        <Card
          title={project.title}
          description={project.description}
          source={project.source}
          live={project.live}
          tags={project.tags}
          img={project.img}
          titleRibbon={project.titleRibbon}
        />
      ))
    }
  </div>
</div>
