---
import GitHubIcon from "./icons/GitHub.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
---

<div class="max-w-lg xl:max-w-3xl">
  <h1
    class="text-(--text-normal) text-3xl xl:text-6xl mb-3 sm:text-4xl 2xl:max-w-6xl"
  >
    Hi, I'm <span class="text-(--text-on-accent)">Angel Andrade</span>
  </h1>
  <h2
    class="text-(--text-normal) font-normal text-lg sm:text-xl mb-3 xl:text-3xl"
  >
    Full Stack Developer & Hacker Enthusiast
  </h2>
  <p class="text-(--text-muted) mb-8 text-sm xl:text-lg max-w-[600px]">
    Focused on software development and self-taught pentester. Always ready to
    learn and take on new challenges.
  </p>
  <div class="flex gap-3" aria-label="Social media">
    <a
      class=""
      href="https://github.com/peek4bUh"
      target="_blank"
      aria-label="GitHub"
      title="GitHub"
    >
      <GitHubIcon />
    </a>
    <a
      href="https://www.linkedin.com/in/angel-andrade-berganti%C3%B1os-3791a7176/"
      target="_blank"
      aria-label="LinkedIn"
      title="LinkedIn"
    >
      <LinkedInIcon />
    </a>
  </div>
</div>
