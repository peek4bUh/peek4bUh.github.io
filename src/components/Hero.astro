---
import GitHubIcon from "./icons/GitHub.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
---

<div>
  <h1 class="text-3xl mb-3">
    Hi, I'm <span class="text-(--color-accent)">Angel Andrade</span>
  </h1>
  <h2 class="text-slate-400 font-normal text-lg mb-3">
    Full Stack Developer & Hacker Enthusiast
  </h2>
  <p class="text-gray-500 mb-8 text-sm max-w-[600px]">
    I build exceptional digital experiences with clean, efficient code.
  </p>
  <div class="flex gap-3" aria-label="Social media">
    <a
      class=""
      href="https://github.com/peek4bUh"
      target="_blank"
      aria-label="GitHub"
      title="GitHub"
    >
      <GitHubIcon />
    </a>
    <a
      href="https://www.linkedin.com/in/angel-andrade-berganti%C3%B1os-3791a7176/"
      target="_blank"
      aria-label="LinkedIn"
      title="LinkedIn"
    >
      <LinkedInIcon />
    </a>
  </div>
</div>
