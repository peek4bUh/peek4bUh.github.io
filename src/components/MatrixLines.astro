<div class="matrix-container">
  <canvas id="matrix-canvas"></canvas>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('matrix-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    
    let width = window.innerWidth;
    let height = window.innerHeight;
    
    // Set canvas dimensions
    const setCanvasDimensions = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    };
    
    setCanvasDimensions();
    window.addEventListener('resize', setCanvasDimensions);
    
    // Line properties
    const lines = [];
    const maxLines = 100;
    const lineColors = [
      'rgba(88, 166, 255, 0.7)',  // Main accent color
      'rgba(88, 166, 255, 0.5)',
      'rgba(88, 166, 255, 0.3)',
      'rgba(240, 246, 252, 0.5)', // White text color
      'rgba(139, 148, 158, 0.6)', // Secondary text color
    ];
    
    // Line class
    class Line {
      x1: number;
      y1: number;
      x2: number;
      y2: number;
      color: string;
      speed: number;
      maxLength: number;
      currentLength: number;
      direction: number;
      thickness: number;
      
      constructor() {
        this.reset();
      }
      
      reset() {
        // Random starting position
        this.x1 = Math.random() * width;
        this.y1 = Math.random() * height;
        
        // Random direction
        const angle = Math.random() * Math.PI * 2;
        this.direction = angle;
        
        // Random length
        this.maxLength = Math.random() * 150 + 50;
        this.currentLength = 0;
        
        // Random speed
        this.speed = Math.random() * 2 + 0.5;
        
        // Random color
        this.color = lineColors[Math.floor(Math.random() * lineColors.length)];
        
        // Random thickness
        this.thickness = Math.random() * 2 + 0.5;
        
        // Calculate end point
        this.x2 = this.x1;
        this.y2 = this.y1;
      }
      
      update() {
        if (this.currentLength < this.maxLength) {
          // Grow the line
          this.currentLength += this.speed;
          this.x2 = this.x1 + Math.cos(this.direction) * this.currentLength;
          this.y2 = this.y1 + Math.sin(this.direction) * this.currentLength;
          
          // Check if line is out of bounds
          if (this.x2 < 0 || this.x2 > width || this.y2 < 0 || this.y2 > height) {
            this.reset();
          }
        } else {
          // Line reached max length, create a new one
          this.reset();
        }
      }
      
      draw(ctx: CanvasRenderingContext2D) {
        ctx.beginPath();
        ctx.moveTo(this.x1, this.y1);
        ctx.lineTo(this.x2, this.y2);
        ctx.strokeStyle = this.color;
        ctx.lineWidth = this.thickness;
        ctx.stroke();
      }
    }
    
    // Initialize lines
    for (let i = 0; i < maxLines; i++) {
      lines.push(new Line());
    }
    
    // Animation loop
    function animate() {
      // Clear canvas with semi-transparent background for trail effect
      ctx.fillStyle = 'rgba(13, 17, 23, 0.1)';
      ctx.fillRect(0, 0, width, height);
      
      // Update and draw lines
      lines.forEach(line => {
        line.update();
        line.draw(ctx);
      });
      
      requestAnimationFrame(animate);
    }
    
    animate();
  });
</script>

<style>
  .matrix-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }
  
  canvas {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }
</style>
